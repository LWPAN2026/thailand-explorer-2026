</ul>
</section>
</main><footer><strong>Build V2.1 Embedded｜2026-08-06</strong><br>Thailand Explorer 2026 Complete · 資料整理 2026-08-06</footer><script>
function toggleDark(){document.body.classList.toggle('dark');localStorage.setItem('dark',document.body.classList.contains('dark'))}
if(localStorage.getItem('dark')==='true')document.body.classList.add('dark');
function copyText(id,btn){const t=document.getElementById(id).innerText;navigator.clipboard.writeText(t).then(()=>{const o=btn.innerText;btn.innerText='已複製';setTimeout(()=>btn.innerText=o,1200)})}
document.querySelectorAll('input[type=checkbox]').forEach((el,i)=>{const key='trip-check-'+i;el.checked=localStorage.getItem(key)==='1';el.addEventListener('change',()=>localStorage.setItem(key,el.checked?'1':'0'))});
function cardTitle(card){const h=card.querySelector('h3');return h?h.innerText.trim():'未命名收藏'}
function getFavs(){try{return JSON.parse(localStorage.getItem('trip-favs')||'[]')}catch(e){return[]}}
function setFavs(x){localStorage.setItem('trip-favs',JSON.stringify(x));renderFavs()}
function toggleFav(btn){const card=btn.closest('.fav-card');const title=cardTitle(card);let favs=getFavs();if(favs.includes(title)){favs=favs.filter(x=>x!==title);btn.classList.remove('active');btn.innerText='♡'}else{favs.push(title);btn.classList.add('active');btn.innerText='♥'}setFavs(favs)}
function syncFavButtons(){const favs=getFavs();document.querySelectorAll('.fav-card').forEach(card=>{const b=card.querySelector('.heart');if(favs.includes(cardTitle(card))){b.classList.add('active');b.innerText='♥'}})}
function renderFavs(){const box=document.getElementById('favList');if(!box)return;const favs=getFavs();box.innerHTML=favs.length?favs.map(x=>'<div class="fav-row">❤️ '+x+'</div>').join(''):'<p class="small">目前尚未收藏。</p>'}
function speakThai(text){if('speechSynthesis'in window){speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(text);u.lang='th-TH';speechSynthesis.speak(u)}}
syncFavButtons();renderFavs();
if('serviceWorker'in navigator){window.addEventListener('load',()=>navigator.serviceWorker.register('./service-worker.js'))}
let deferredPrompt;const ib=document.getElementById('installBtn');window.addEventListener('beforeinstallprompt',e=>{e.preventDefault();deferredPrompt=e;if(ib)ib.hidden=false});
if(ib)ib.addEventListener('click',async()=>{if(!deferredPrompt)return;deferredPrompt.prompt();await deferredPrompt.userChoice;deferredPrompt=null;ib.hidden=true});

function updateCountdown(){
 const target=new Date('2026-09-18T00:00:00+08:00');
 const now=new Date(); const diff=target-now; const el=document.getElementById('countdown');
 if(!el)return;
 if(diff<=0){el.textContent='旅程已開始';return}
 const days=Math.floor(diff/86400000), hrs=Math.floor((diff%86400000)/3600000);
 el.textContent=days+' 天 '+hrs+' 小時';
}
updateCountdown();setInterval(updateCountdown,3600000);

(async function refreshOldBuild(){
  const build='v21-embedded';
  if(localStorage.getItem('trip-build')!==build){
    if('caches' in window){
      const keys=await caches.keys();
      await Promise.all(keys.map(k=>caches.delete(k)));
    }
    if('serviceWorker' in navigator){
      const regs=await navigator.serviceWorker.getRegistrations();
      await Promise.all(regs.map(r=>r.unregister()));
    }
    localStorage.setItem('trip-build',build);
    setTimeout(()=>location.reload(),300);
  }
})();
</script></body></html>